---
const { title = 'Mr. Mime' } = Astro.props;
---
<!DOCTYPE html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content="Juego Mr. Mime: adivina la combinación secreta de colores." />
    <link rel="icon" type="image/png" href="/mr-mime.png" />
  </head>
  <body class="min-h-screen bg-gradient-to-br from-slate-900 via-purple-900 to-slate-900 text-white">
    <slot />
  </body>
</html>
